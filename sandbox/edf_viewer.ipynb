    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from pyedflib import EdfReader\\n\",\n",
    "    \"from datetime import timedelta\\n\",\n",
    "    \"import matplotlib.pyplot as plt\\n\",\n",
    "    \"import pandas as pd\\n\",\n",
    "    \"import sys\\n\",\n",
    "    \"from pathlib import Path\\n\",\n",
    "    \"from pyedflib import highlevel\\n\",\n",
    "    \"\\n\",\n",
    "    \"sys.path.append('..')\\n\",\n",
    "    \"from utils.timezone import timezone_from_edf_annotation\"\n",
    "   ],\n",
    "   \"id\": \"21a3b414177d5189\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 2\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-03-27T18:06:45.267985Z\",\n",
    "     \"start_time\": \"2026-03-27T18:06:45.232287Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"def show_edf(path: Path, values=('timezone', 'start', 'end', 'duration'), return_data: bool = False):\\n\",\n",
    "    \"    if 'timezone' in values:\\n\",\n",
    "    \"        with EdfReader(str(path)) as f:\\n\",\n",
    "    \"            ann = f.read_annotation()\\n\",\n",
    "    \"        try:\\n\",\n",
    "    \"            tz = timezone_from_edf_annotation(ann)\\n\",\n",
    "    \"        except:\\n\",\n",
    "    \"            tz = 'Not found'\\n\",\n",
    "    \"        print(f'Timezone: {tz}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    signals, sig_headers, header = highlevel.read_edf(str(path))\\n\",\n",
    "    \"\\n\",\n",
    "    \"    start = header['startdate']\\n\",\n",
    "    \"    sfreq = sig_headers[0]['sample_frequency']\\n\",\n",
    "    \"    duration = timedelta(seconds=len(signals[0]) / sfreq)\\n\",\n",
    "    \"    end = start + duration\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if 'start' in values:    print(f'Start:    {start}')\\n\",\n",
    "    \"    if 'end' in values:      print(f'End:      {end}')\\n\",\n",
    "    \"    if 'duration' in values: print(f'Duration: {duration}')\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Plotting signals\\n\",\n",
    "    \"    fig, axs = plt.subplots(nrows=len(signals), sharex=True, figsize=(20, 8))\\n\",\n",
    "    \"    fig.suptitle(f\\\"{path.parent.parent.name} - {path.name}\\\")\\n\",\n",
    "    \"    for ax, sig_header, signal in zip(axs, sig_headers, signals):\\n\",\n",
    "    \"        sample_period = pd.Timedelta(seconds=1 / sig_header['sample_frequency'])\\n\",\n",
    "    \"        time = pd.date_range(start, periods=len(signal), freq=sample_period)\\n\",\n",
    "    \"\\n\",\n",
    "    \"        ax.plot(time, signal, linewidth=0.5)\\n\",\n",
    "    \"        ax.set_title(sig_header['label'])\\n\",\n",
    "    \"        ax.set_ylabel(sig_header['dimension'])\\n\",\n",
    "    \"    fig.show()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if return_data:\\n\",\n",
    "    \"        return signals, sig_headers, header\"\n",
    "   ],\n",
    "   \"id\": \"ee2e98e13f02218b\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": 3\n",
